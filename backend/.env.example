# Copy to .env to change settings. Never commit .env.
# Everything here is optional; the defaults work out of the box.

# Where recipes come from: "database" (free, default) or "claude" (paid AI)
# RECIPE_SOURCE=database
# MAX_RECIPES=20
# RECIPE_DB_PATH=data/recipes.db

# Only needed when RECIPE_SOURCE=claude
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium
# CLAUDE_MAX_RECIPES=6
# CLAUDE_TIMEOUT=90
